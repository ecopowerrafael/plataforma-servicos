NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/plataforma_servicos?connection_limit=10
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
VITE_API_URL=http://127.0.0.1:3000
APP_WEB_URL=http://localhost:5173
PUBLIC_BASE_DOMAIN=sites.example.com
AUTH_COOKIE_NAME=ps_session
AUTH_SESSION_TTL_HOURS=168
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_COOKIE_SECURE=false
PASSWORD_ARGON2_MEMORY_COST=65536
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_PARALLELISM=1
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=48
SERVICE_IMAGE_STORAGE_DIR=uploads/services
SERVICE_IMAGE_MAX_BYTES=5242880
SERVICE_IMAGE_MIN_DIMENSION=32
SERVICE_IMAGE_MAX_DIMENSION=4096
