# =============================================================================
# Exemplo de ambiente de PRODUÇÃO (deploy single-origin — ex.: Node.js
# compartilhado da Hostinger). Copie para `.env` no servidor e preencha os
# valores reais. NUNCA versione o `.env` com credenciais.
#
# Neste modelo a própria API serve o frontend Vite compilado (WEB_DIST_DIR),
# então a API e o site respondem no MESMO domínio/origem — não há CORS entre
# eles. Ajuste todos os "example.com" para o seu domínio real (com HTTPS).
# =============================================================================

NODE_ENV=production

# A Hostinger (e a maioria das hospedagens Node gerenciadas) injeta a porta via
# a variável PORT — a aplicação a reaproveita automaticamente. Só defina
# API_PORT se você controla a porta manualmente. API_HOST assume 0.0.0.0.
# API_HOST=0.0.0.0
# API_PORT=3000

# Banco MySQL da Hostinger (hPanel > Bancos de dados MySQL). Use o host/porta
# fornecidos pelo painel; mantenha connection_limit baixo em plano compartilhado.
DATABASE_URL=mysql://USUARIO:SENHA@127.0.0.1:3306/NOME_DO_BANCO?connection_limit=5

# Origens permitidas para requisições autenticadas. No modo single-origin é o
# próprio domínio público do site. Nunca use "*" em produção.
CORS_ORIGINS=https://app.example.com

LOG_LEVEL=info

# URL pública do frontend. No modo single-origin é o mesmo domínio da API.
# Deve usar HTTPS em produção. Usada também para montar links em e-mails.
VITE_API_URL=https://app.example.com
APP_WEB_URL=https://app.example.com

# Domínio-base para sites públicos de tenants por subdomínio (opcional).
# PUBLIC_BASE_DOMAIN=sites.example.com

# Frontend compilado que a API deve servir (gerado por `npm run build`).
# Caminho absoluto no servidor OU relativo ao diretório de trabalho do processo.
WEB_DIST_DIR=./apps/web/dist

# Sessão/cookies — em produção o cookie DEVE ser Secure (HTTPS).
AUTH_COOKIE_NAME=ps_session
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_HOURS=168
AUTH_MAX_ACTIVE_SESSIONS=5

# Hash de senha (Argon2). Em plano compartilhado com pouca RAM, reduza o
# memory cost se houver erros de memória (mínimo aceito: 19456).
PASSWORD_ARGON2_MEMORY_COST=65536
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_PARALLELISM=1

LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=48

# Uploads — use um diretório PERSISTENTE fora de dist/ para sobreviver a novos
# deploys. Caminho absoluto recomendado no servidor.
SERVICE_IMAGE_STORAGE_DIR=./storage/uploads/services
TENANT_MEDIA_STORAGE_DIR=./storage/uploads/tenant-media
PROFESSIONAL_IMAGE_STORAGE_DIR=./storage/uploads/professionals
SERVICE_IMAGE_MAX_BYTES=5242880
SERVICE_IMAGE_MIN_DIMENSION=32
SERVICE_IMAGE_MAX_DIMENSION=4096

# --- Integrações opcionais (deixe em branco se não usar) --------------------

# E-mail transacional (recuperação de senha, convites). Sem SMTP, esses envios
# ficam desabilitados, mas o restante do sistema funciona.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@example.com
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com

# Web Push (notificações push do cliente). Gere as chaves VAPID com web-push.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:no-reply@example.com

# Criptografia das credenciais de gateway de pagamento (32 bytes em hex = 64
# caracteres). Obrigatória apenas se for usar gateways de pagamento.
# PAYMENT_GATEWAY_ENCRYPTION_KEY=
