# =============================================================================
# Exemplo de ambiente de PRODUÇÃO (deploy single-origin — Node.js compartilhado
# da Hostinger). Copie para `.env` no servidor e preencha os valores reais.
# NUNCA versione o `.env` com credenciais.
#
# Neste modelo a própria API serve o frontend Vite compilado (WEB_DIST_DIR),
# então API e site respondem no MESMO domínio/origem — não há CORS entre eles.
#
# Node.js 22 recomendado; mínimo 20.19 (ver `.nvmrc` / `engines`).
# =============================================================================

NODE_ENV=production

# A Hostinger injeta a porta via a variável PORT — a aplicação a reaproveita
# automaticamente. Só defina API_PORT se controlar a porta manualmente.
# API_HOST assume 0.0.0.0 por padrão.
API_HOST=0.0.0.0
# API_PORT=3000

# --- Banco de dados MySQL ----------------------------------------------------
# NÃO é necessário configurar DATABASE_URL: a aplicação (e a CLI do Prisma via
# prisma.config.ts) monta a connection string internamente a partir das
# variáveis DB_* abaixo, com URL-encoding de usuário/senha/nome do banco.
#
# Obrigatórias em produção: DB_NAME, DB_USER, DB_PASSWORD.
# Padrões: DB_HOST=127.0.0.1, DB_PORT=3306, DB_CONNECTION_LIMIT=5.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u000000000_exemplo
DB_USER=u000000000_exemplo
DB_PASSWORD=SUA_SENHA_DO_PAINEL_HOSTINGER
DB_CONNECTION_LIMIT=5
# Alternativa (tem prioridade se definida) — não precisa configurar na Hostinger:
# DATABASE_URL=mysql://USUARIO:SENHA@127.0.0.1:3306/NOME_DO_BANCO?connection_limit=5

LOG_LEVEL=info

# --- Domínio / single-origin -------------------------------------------------
# Domínio público do site (mesmo domínio serve API + frontend). Use HTTPS.
# Inclua o www em CORS_ORIGINS (separado por vírgula) se o site também
# responder em www.
CORS_ORIGINS=https://agendei.site,https://www.agendei.site
VITE_API_URL=https://agendei.site
APP_WEB_URL=https://agendei.site

# Base para sites públicos de tenants por subdomínio (ex.: cliente.agendei.site).
# Requer DNS curinga (*.agendei.site) — ver limitações no guia de deploy.
PUBLIC_BASE_DOMAIN=agendei.site

# Frontend compilado que a API serve (gerado por `npm run build`).
# OPCIONAL em produção: se omitido, a API localiza `apps/web/dist`
# automaticamente (independente do diretório de trabalho). Defina apenas se o
# dist estiver em outro caminho (absoluto ou relativo ao cwd do processo).
# WEB_DIST_DIR=./apps/web/dist

# --- Sessão / cookies (Secure obrigatório em produção) -----------------------
AUTH_COOKIE_NAME=ps_session
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_HOURS=168
AUTH_MAX_ACTIVE_SESSIONS=5

# --- Hash de senha (Argon2) --------------------------------------------------
# Em plano compartilhado com pouca RAM, reduza o memory cost se houver erros de
# memória (mínimo aceito: 19456).
PASSWORD_ARGON2_MEMORY_COST=65536
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_PARALLELISM=1

LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=48

# --- Uploads -----------------------------------------------------------------
# Use diretório PERSISTENTE fora de dist/ para sobreviver a novos deploys.
SERVICE_IMAGE_STORAGE_DIR=./storage/uploads/services
TENANT_MEDIA_STORAGE_DIR=./storage/uploads/tenant-media
PROFESSIONAL_IMAGE_STORAGE_DIR=./storage/uploads/professionals
SERVICE_IMAGE_MAX_BYTES=5242880
SERVICE_IMAGE_MIN_DIMENSION=32
SERVICE_IMAGE_MAX_DIMENSION=4096

# --- Integrações opcionais (deixe em branco/omitido se não usar) -------------
# Estas chaves precisam permanecer ESTÁVEIS após entrar em produção — configure
# uma vez e não regenere a cada deploy.

# E-mail transacional (recuperação de senha, convites).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@agendei.site
# SMTP_PASS=
# SMTP_FROM=no-reply@agendei.site

# Web Push (notificações push do cliente). Gere as chaves VAPID uma única vez.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:no-reply@agendei.site

# Criptografia das credenciais de gateway de pagamento (32 bytes em hex = 64
# caracteres). Obrigatória apenas se for usar gateways de pagamento. Mantenha
# ESTÁVEL — trocar esta chave invalida as credenciais já cifradas no banco.
# PAYMENT_GATEWAY_ENCRYPTION_KEY=
