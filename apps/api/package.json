{
  "name": "@plataforma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "test:unit": "vitest run --config ./vitest.config.ts --pool=threads --no-file-parallelism --maxWorkers=1 --exclude '**/tests/**' --exclude '**/*integration*' --exclude '**/*.contract.test.ts'",
    "test:contract": "vitest run --config ./vitest.config.ts --pool=threads --no-file-parallelism --maxWorkers=1 --include '**/*.contract.test.ts'",
    "test:integration:local": "vitest run --config ./vitest.config.ts --pool=threads --no-file-parallelism --maxWorkers=1 --include '**/*integration*.test.ts' --include '**/*mysql-integration*.test.ts'",
    "test:critical": "vitest run --config ./vitest.config.ts --pool=threads --no-file-parallelism --maxWorkers=1 --reporter=dot src/modules/auth/auth-startup.test.ts src/modules/integrations/whatsapp-connection.service.test.ts src/modules/integrations/whatsapp-inbound.test.ts src/modules/integrations/whatsapp-provider-persistence.test.ts src/modules/prospecting/prospecting-inbound.test.ts src/modules/payments/payment-origin-validator.test.ts src/modules/tenants/plan-entitlement.service.test.ts",
    "test:all": "vitest run --config ./vitest.config.ts",
    "db:generate": "prisma generate --config prisma-v2/prisma.config.ts",
    "db:generate:v2": "prisma generate --config prisma-v2/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma-v2/prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma-v2/prisma.config.ts",
    "db:migrate:legacy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset-initial": "tsx src/database/reset-initial-database.ts",
    "db:bootstrap": "tsx src/database/bootstrap.ts",
    "db:bootstrap:system": "tsx src/database/bootstrap.ts",
    "db:seed:dev": "tsx src/database/seed-dev-fixtures.ts",
    "platform-admin:create": "tsx src/database/create-platform-admin.ts",
    "worker:once": "node dist/worker/run-once.js",
    "db:migrate:recover": "tsx src/database/recover-failed-migrations.ts"
    ,"db:status": "prisma migrate status --config prisma-v2/prisma.config.ts"
    ,"db:status:legacy": "prisma migrate status"
    ,"db:status:v2": "prisma migrate status --config prisma-v2/prisma.config.ts"
    ,"db:migrate:v2": "prisma migrate deploy --config prisma-v2/prisma.config.ts"
    ,"db:verify": "prisma validate && node ../../scripts/database/verify-schema.mjs"
    ,"db:backup:schema": "node ../../scripts/database/backup-schema.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@plataforma/shared": "^0.1.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.0.8",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "tsx": "^4.23.13",
    "web-push": "^3.6.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "vitest": "^4.1.10"
  }
}
