  title      String              @db.VarChar(160)
  message    String              @db.Text
  status     NotificationCampaignStatus @default(QUEUED)
  recipientCount Int             @default(0) @map("recipient_count") @db.UnsignedInt
  eligibleCount Int              @default(0) @map("eligible_count") @db.UnsignedInt
  skippedCount Int               @default(0) @map("skipped_count") @db.UnsignedInt
  deliveryCount Int              @default(0) @map("delivery_count") @db.UnsignedInt
  materializedCount Int          @default(0) @map("materialized_count") @db.UnsignedInt
  startedAt DateTime?            @map("started_at") @db.DateTime(3)
  completedAt DateTime?          @map("completed_at") @db.DateTime(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipients NotificationCampaignRecipient[]

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@unique([tenantId, idempotencyKey])
  @@map("notification_campaigns")
}

