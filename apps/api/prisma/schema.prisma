/**
 * Orcamento/tratamento definido apos a avaliacao de um servico sob orcamento.
 * Nao substitui o Appointment: as sessoes continuam sendo agendamentos reais,
 * apenas vinculados ao plano.
 */
model TreatmentPlan {
  id                  BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  publicId            String               @unique @map("public_id") @db.Char(36)
  tenantId            BigInt               @map("tenant_id") @db.UnsignedBigInt
  customerId          BigInt               @map("customer_id") @db.UnsignedBigInt
  serviceId           BigInt               @map("service_id") @db.UnsignedBigInt
  professionalId      BigInt               @map("professional_id") @db.UnsignedBigInt
  /** Avaliacao que originou o orcamento; nunca conta como sessao. */
  originAppointmentId BigInt               @unique @map("origin_appointment_id") @db.UnsignedBigInt
  /** Nome do tratamento definido pelo profissional; planos antigos caem no nome do servico. */
  title               String?              @db.VarChar(120)
  status              TreatmentPlanStatus  @default(PENDING)
  billingMode         TreatmentBillingMode @map("billing_mode")
  amountCents         BigInt               @map("amount_cents") @db.UnsignedBigInt
  sessionsPlanned     Int?                 @map("sessions_planned") @db.UnsignedSmallInt
  returnIntervalDays  Int?                 @map("return_interval_days") @db.UnsignedSmallInt
  notes               String?              @db.VarChar(1000)
  approvedAt          DateTime?            @map("approved_at") @db.DateTime(3)
  startedAt           DateTime?            @map("started_at") @db.DateTime(3)
  completedAt         DateTime?            @map("completed_at") @db.DateTime(3)
  canceledAt          DateTime?            @map("canceled_at") @db.DateTime(3)
  canceledReason      String?              @map("canceled_reason") @db.VarChar(500)
  createdAt           DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service             Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  professional        Professional         @relation(fields: [professionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  originAppointment   Appointment          @relation("TreatmentPlanOrigin", fields: [originAppointmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions            Appointment[]        @relation("TreatmentPlanSessions")

  @@index([tenantId, customerId, status])
  @@index([tenantId, professionalId, status])
  @@map("treatment_plans")
}

model AppointmentWaitlist {
  id                 BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String                          @unique @map("public_id") @db.Char(36)
  tenantId           BigInt                          @map("tenant_id") @db.UnsignedBigInt
  customerId         BigInt                          @map("customer_id") @db.UnsignedBigInt
