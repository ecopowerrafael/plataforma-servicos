  SKIPPED
  FAILED
}

enum CustomerRecoveryRuleType {
  INACTIVE
  CANCELED_NO_REBOOK
  NO_SHOW_NO_REBOOK
  POST_SERVICE_NO_RETURN
  BIRTHDAY
}

enum TenantDomainType {
  CUSTOM
  SUBDOMAIN
}

enum TenantDomainStatus {
  PENDING
  ACTIVE
  FAILED
}

enum PlatformAdministratorStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CommercialPlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum PlanLimitValueType {
  INTEGER
  BOOLEAN
  STRING
}

enum PublicSiteBlockedBehavior {
  NORMAL
  HIDE_BOOKING
  OFFLINE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

model SystemMetadata {
  id                    BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  applicationVersion    String   @map("application_version") @db.VarChar(50)
  databaseInitializedAt DateTime @default(now()) @map("database_initialized_at") @db.DateTime(3)
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("system_metadata")
}

model Tenant {
  id                           BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                     String                           @unique @map("public_id") @db.Char(36)
  slug                         String                           @unique @db.VarChar(63)
  slugChangedAt                DateTime?                        @map("slug_changed_at") @db.DateTime(3)
  legalName                    String                           @map("legal_name") @db.VarChar(160)
  displayName                  String                           @map("display_name") @db.VarChar(120)
  status                       TenantStatus                     @default(ACTIVE)
  timezone                     String                           @db.VarChar(64)
  locale                       String                           @db.VarChar(16)
  currency                     String                           @db.Char(3)
  businessProfile              BusinessProfile                  @default(GENERIC) @map("business_profile")
  businessTypeCustom           String?                           @map("business_type_custom") @db.VarChar(120)
  onboardingStep               String                           @default("WELCOME") @map("onboarding_step") @db.VarChar(40)
  onboardingCompletedAt        DateTime?                        @map("onboarding_completed_at") @db.DateTime(3)
  onboardingChecklistHiddenAt  DateTime?                        @map("onboarding_checklist_hidden_at") @db.DateTime(3)
  /// Marca técnica do bootstrap de conteúdo inicial; garante idempotência.
  starterContentSeededAt       DateTime?                        @map("starter_content_seeded_at") @db.DateTime(3)
  /// publicIds do conteúdo inicial gerado pelo sistema, para poder substituí-lo
  /// quando o tipo de negócio muda durante o onboarding.
  starterContentIds            Json?                            @map("starter_content_ids")
  createdAt                    DateTime                         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                    DateTime                         @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  settings                     TenantSettings?
  branding                     TenantBranding?
  terminology                  TenantTerminology?
  featureOverrides             TenantFeatureOverride[]
  customFields                 TenantCustomFieldDefinition[]
  services                     Service[]
  serviceVariations            ServiceVariation[]
  combos                       Combo[]
  comboItems                   ComboItem[]
  customers                    Customer[]
  appointments                 Appointment[]
  treatmentPlans               TreatmentPlan[]
  appointmentWaitlists         AppointmentWaitlist[]
  waitlistOpportunities        AppointmentWaitlistOpportunity[]
  serviceCategories            ServiceCategory[]
  professionals                Professional[]
  professionalServices         ProfessionalService[]
  professionalUnits            ProfessionalUnit[]
  professionalWorkSchedules    ProfessionalWorkSchedule[]
  professionalUnavailabilities ProfessionalUnavailability[]
  businessUnitOperatingHours   BusinessUnitOperatingHours[]
  businessUnitDateOverrides    BusinessUnitDateOverride[]
  appointmentHistoryEntries    AppointmentHistoryEntry[]
  customerSessions             CustomerSession[]
  customerPasswordResets       CustomerPasswordResetToken[]
  businessUnits                BusinessUnit[]
  memberships                  TenantMembership[]
  roles                        Role[]
  invitations                  UserInvitation[]
  auditLogs                    AuditLog[]
  subscriptions                TenantSubscription[]
  subscriptionHistory          SubscriptionHistory[]
  mediaAssets                  TenantMediaAsset[]
  publicSite                   TenantPublicSite?
  customerFavorites            CustomerFavorite[]
  appointmentReviews           AppointmentReview[]
  notificationLogs             NotificationLog[]
  notificationCampaigns        NotificationCampaign[]
  notificationTemplates        NotificationTemplate[]
  pushSubscriptions            PushSubscription[]
  productCategories            ProductCategory[]
  products                     Product[]
  productStocks                ProductStock[]
  stockMovements               StockMovement[]
  productSales                 ProductSale[]
  productSaleItems             ProductSaleItem[]
  payments                     Payment[]
  paymentMethods               PaymentMethod[]
  cashRegisters                CashRegister[]
  cashMovements                CashMovement[]
  receipts                     Receipt[]
  professionalCommissions      ProfessionalCommission[]
  financialClosings            FinancialClosing[]
  paymentGatewayConfigs        PaymentGatewayConfig[]
  paymentGatewayCharges        PaymentGatewayCharge[]
  paymentGatewayEvents         PaymentGatewayEvent[]
  automations                  TenantAutomation[]
  automationExecutions         AutomationExecution[]
  recoveryRules                CustomerRecoveryRule[]
  recoveryExecutions           CustomerRecoveryExecution[]
  coupons                      Coupon[]
  couponRedemptions            CouponRedemption[]
  loyaltyRules                 LoyaltyRule[]
  loyaltyLedgerEntries         LoyaltyLedgerEntry[]
  domains                      TenantDomain[]
  whatsappConfig               TenantWhatsAppConfig?
  whatsappInboundEvents        WhatsAppInboundEvent[]
  whatsappOutboundMessages     WhatsAppOutboundMessage[]
  whatsappConversations        WhatsAppConversation[]
  externalIntegrations         ExternalIntegration[]
  directoryBusinesses          DirectoryBusiness[]

  @@index([status])
  @@map("tenants")
}

enum DirectoryImportStatus {
  ANALYZED
  QUEUED
  PROCESSING
  PAUSED
  COMPLETED
  FAILED
}

enum DirectoryImportItemStatus {
  CREATED
  UPDATED
  UNCHANGED
  POSSIBLE_DUPLICATE
  SKIPPED
  ERROR
}

enum DirectoryBusinessEventType {
  BUSINESS_VIEW
  WHATSAPP_CLICK
}

enum DirectorySeoSyncStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum SeoUrlSubmissionProvider {
  INDEXNOW
}

enum SeoUrlSubmissionReason {
  CREATED
  UPDATED
  DELETED
  MANUAL
}

enum SeoUrlSubmissionStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum SeoUrlInspectionStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model DirectoryCategory {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId     String   @unique @map("public_id") @db.Char(36)
  name         String   @db.VarChar(120)
  singularName String   @map("singular_name") @db.VarChar(120)
  pluralName   String   @map("plural_name") @db.VarChar(120)
  slug         String   @unique @db.VarChar(120)
  description  String?  @db.Text
  seoTitle     String?  @map("seo_title") @db.VarChar(180)
  seoDescription String? @map("seo_description") @db.VarChar(320)
  icon         String?  @db.VarChar(40)
  active       Boolean  @default(true)
  indexable    Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  externalSearchTerms Json? @map("external_search_terms")
  geoapifyCategories Json? @map("geoapify_categories")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  businesses   DirectoryBusiness[]
  importItems  DirectoryImportItem[]
  seoMetrics   DirectorySeoDailyMetric[]
  seoQueries   DirectorySeoQueryMetric[]
  externalSearches DirectoryExternalSearchCache[]

  @@index([active, sortOrder])
  @@map("directory_categories")
}

model DirectoryPostalCodeCache {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  cep          String   @unique @db.Char(8)
  city         String   @db.VarChar(120)
  state        String   @db.Char(2)
  neighborhood String?  @db.VarChar(120)
  street       String?  @db.VarChar(180)
  latitude     Float?
  longitude    Float?
  provider     String   @db.VarChar(40)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("directory_postal_code_cache")
}

model DirectoryExternalSearchCache {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  cacheKey   String   @unique @map("cache_key") @db.Char(64)
  categoryId BigInt   @map("category_id") @db.UnsignedBigInt
  cep        String   @db.Char(8)
  radius     Int
  results    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  category   DirectoryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, cep, radius])
  @@map("directory_external_search_cache")
}

model DirectoryBusiness {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String   @unique @map("public_id") @db.Char(36)
  categoryId       BigInt   @map("category_id") @db.UnsignedBigInt
  tenantId         BigInt?  @map("tenant_id") @db.UnsignedBigInt
  sourceLocalId    String?  @map("source_local_id") @db.VarChar(120)
  sourceSegmentKey String?  @map("source_segment_key") @db.VarChar(120)
  sourceSearchTerm String?  @map("source_search_term") @db.VarChar(160)
  name             String   @db.VarChar(180)
  slug             String   @db.VarChar(180)
  citySlug         String   @map("city_slug") @db.VarChar(180)
  rawAddress       String   @map("raw_address") @db.Text
  street           String?  @db.VarChar(180)
  number           String?  @db.VarChar(32)
  complement       String?  @db.VarChar(160)
  neighborhood     String?  @db.VarChar(120)
  city             String   @db.VarChar(120)
  state            String   @db.Char(2)
  postalCode       String?  @map("postal_code") @db.Char(8)
  ibgeCode         String?  @map("ibge_code") @db.VarChar(16)
  phone            String?  @db.VarChar(20)
  whatsapp         String?  @db.VarChar(20)
  email            String?  @db.VarChar(254)
  websiteUrl       String?  @map("website_url") @db.VarChar(500)
  imageUrl         String?  @map("image_url") @db.VarChar(500)
  sourceUrl        String?  @map("source_url") @db.VarChar(500)
  relevanceScore   Int?     @map("relevance_score")
  reviewStatus     String?  @map("review_status") @db.VarChar(40)
  active           Boolean  @default(true)
  indexable        Boolean  @default(true)
  sourceHash       String   @map("source_hash") @db.Char(64)
  firstImportedAt  DateTime @default(now()) @map("first_imported_at") @db.DateTime(3)
  lastImportedAt   DateTime @default(now()) @map("last_imported_at") @db.DateTime(3)
  claimedAt        DateTime? @map("claimed_at") @db.DateTime(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  category         DirectoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tenant           Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  importItems      DirectoryImportItem[]
  events           DirectoryBusinessEvent[]
  seoMetrics       DirectorySeoDailyMetric[]
  seoQueries       DirectorySeoQueryMetric[]
  seoSubmissions   SeoUrlSubmission[]
  seoInspections   SeoUrlInspection[]

  @@unique([categoryId, state, citySlug, slug], map: "udb_category_city_slug")
  @@index([categoryId, citySlug, active])
  @@index([city, state])
  @@index([ibgeCode])
  @@index([whatsapp])
  @@index([phone])
  @@index([tenantId])
  @@map("directory_businesses")
}

model DirectoryBusinessEvent {
  id          BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  publicId    String                    @unique @map("public_id") @db.Char(36)
  businessId  BigInt                    @map("business_id") @db.UnsignedBigInt
  type        DirectoryBusinessEventType
  visitorHash String?                   @map("visitor_hash") @db.Char(64)
  sessionHash String?                   @map("session_hash") @db.Char(64)
  sourcePath  String                    @map("source_path") @db.VarChar(500)
  referrer    String?                   @db.VarChar(500)
  utmSource   String?                   @map("utm_source") @db.VarChar(160)
  utmMedium   String?                   @map("utm_medium") @db.VarChar(160)
  utmCampaign String?                   @map("utm_campaign") @db.VarChar(160)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  business    DirectoryBusiness         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, type, createdAt])
  @@index([type, createdAt])
  @@index([visitorHash, businessId, type, createdAt])
  @@map("directory_business_events")
}

model DirectorySeoDailyMetric {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  date        DateTime @db.Date
  pageUrl     String   @map("page_url") @db.VarChar(700)
  pageHash    String   @map("page_hash") @db.Char(64)
  businessId  BigInt?  @map("business_id") @db.UnsignedBigInt
  categoryId  BigInt?  @map("category_id") @db.UnsignedBigInt
  citySlug    String?  @map("city_slug") @db.VarChar(180)
  clicks      Float    @default(0)
  impressions Float    @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  syncedAt    DateTime @default(now()) @map("synced_at") @db.DateTime(3)
  business    DirectoryBusiness? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  category    DirectoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([date, pageHash], map: "udsdm_date_page")
  @@index([date])
  @@index([businessId, date])
  @@index([categoryId, date])
  @@map("directory_seo_daily_metrics")
}

model DirectorySeoQueryMetric {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  date        DateTime @db.Date
  pageUrl     String   @map("page_url") @db.VarChar(700)
  pageHash    String   @map("page_hash") @db.Char(64)
  query       String   @db.VarChar(500)
  businessId  BigInt?  @map("business_id") @db.UnsignedBigInt
  categoryId  BigInt?  @map("category_id") @db.UnsignedBigInt
  citySlug    String?  @map("city_slug") @db.VarChar(180)
  clicks      Float    @default(0)
  impressions Float    @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  syncedAt    DateTime @default(now()) @map("synced_at") @db.DateTime(3)
  business    DirectoryBusiness? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  category    DirectoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([date, pageHash, query], map: "udsqm_date_page_query")
  @@index([date])
  @@index([businessId, date])
  @@index([categoryId, date])
  @@map("directory_seo_query_metrics")
}

model DirectorySeoSyncRun {
  id          BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  publicId    String                 @unique @map("public_id") @db.Char(36)
  status      DirectorySeoSyncStatus @default(PENDING)
  fromDate    DateTime               @map("from_date") @db.Date
  toDate      DateTime               @map("to_date") @db.Date
  attempts    Int                    @default(0)
  lastError   String?                @map("last_error") @db.VarChar(1000)
  startedAt   DateTime?              @map("started_at") @db.DateTime(3)
  completedAt DateTime?              @map("completed_at") @db.DateTime(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.DateTime(3)

  @@index([status, createdAt])
  @@map("directory_seo_sync_runs")
}

model SeoUrlSubmission {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String                   @unique @map("public_id") @db.Char(36)
  url            String                   @db.VarChar(700)
  provider       SeoUrlSubmissionProvider
  reason         SeoUrlSubmissionReason
  status         SeoUrlSubmissionStatus   @default(PENDING)
  businessId     BigInt?                  @map("business_id") @db.UnsignedBigInt
  attempts       Int                      @default(0)
  lastError      String?                  @map("last_error") @db.VarChar(1000)
  responseStatus Int?                     @map("response_status")
  lastAttemptAt  DateTime?                @map("last_attempt_at") @db.DateTime(3)
  processedAt    DateTime?                @map("processed_at") @db.DateTime(3)
  nextAttemptAt  DateTime?                @map("next_attempt_at") @db.DateTime(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  business       DirectoryBusiness?       @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@unique([provider, url], map: "usu_provider_url")
  @@index([status, nextAttemptAt])
  @@index([businessId])
  @@map("seo_url_submissions")
}

model SeoUrlInspection {
  id                    BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  publicId              String                 @unique @map("public_id") @db.Char(36)
  url                   String                 @unique @db.VarChar(700)
  businessId            BigInt?                @map("business_id") @db.UnsignedBigInt
  status                SeoUrlInspectionStatus @default(PENDING)
  priority              Int                    @default(0)
  attempts              Int                    @default(0)
  lastError             String?                @map("last_error") @db.VarChar(1000)
  verdict               String?                @db.VarChar(80)
  coverageState         String?                @map("coverage_state") @db.VarChar(160)
  googleCanonical       String?                @map("google_canonical") @db.VarChar(700)
  lastCrawlAt           DateTime?              @map("last_crawl_at") @db.DateTime(3)
  lastAttemptAt         DateTime?              @map("last_attempt_at") @db.DateTime(3)
  processedAt           DateTime?              @map("processed_at") @db.DateTime(3)
  nextAttemptAt         DateTime?              @map("next_attempt_at") @db.DateTime(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  business              DirectoryBusiness?     @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([status, priority, nextAttemptAt])
  @@index([businessId])
  @@map("seo_url_inspections")
}

model DirectoryImport {
  id             BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String                @unique @map("public_id") @db.Char(36)
  filename       String                @db.VarChar(255)
  status         DirectoryImportStatus @default(ANALYZED)
  totalFound     Int                   @default(0) @map("total_found")
  totalSelected  Int                   @default(0) @map("total_selected")
  totalCreated   Int                   @default(0) @map("total_created")
  totalUpdated   Int                   @default(0) @map("total_updated")
  totalUnchanged Int                   @default(0) @map("total_unchanged")
  totalDuplicates Int                  @default(0) @map("total_duplicates")
