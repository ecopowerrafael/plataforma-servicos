generator client {
  provider   = "prisma-client"
  output     = "../src/database-client"
  engineType = "client"
}

datasource db {
  provider = "mysql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  PENDING
}

enum BusinessProfile {
  BARBERSHOP
  BEAUTY_SALON
  AESTHETIC_CLINIC
  MEDICAL_CLINIC
  PSYCHOLOGY
  NUTRITION
  DENTISTRY
  STUDIO
  TATTOO_STUDIO
  PET_CARE
  SPA
  MASSAGE
  PERSONAL_TRAINER
  CONSULTING
  GENERIC
}

enum TenantFeatureSource {
  PROFILE
  OVERRIDE
}

enum TenantCustomFieldSource {
  PROFILE
  OVERRIDE
}

enum TenantCustomFieldScope {
  TENANT
  PROFESSIONAL
  CUSTOMER
  APPOINTMENT
}

enum TenantCustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  BOOLEAN
  DATE
  SELECT
  MULTISELECT
}

enum TenantMediaKind {
  LOGO
  LOGO_COMPACT
  FAVICON
  APP_ICON
  SPLASH
  BANNER_DESKTOP
  BANNER_MOBILE
  INSTITUTIONAL
}

enum TenantPublicTheme {
  CLASSIC
  MODERN
  PREMIUM
}

enum ProfessionalUnavailabilityType {
  BLOCK
  DAY_OFF
  VACATION
  SICK_LEAVE
  PERSONAL
  OTHER
}

enum BusinessUnitDateOverrideType {
  EXCEPTION
  HOLIDAY
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
}

enum BusinessUnitStatus {
  ACTIVE
  INACTIVE
}

enum WeekStartsOn {
  SUNDAY
  MONDAY
}

enum TimeFormat {
  H24 @map("24H")
  H12 @map("12H")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum StockMovementType {
  ENTRY
  MANUAL_EXIT
  POSITIVE_ADJUSTMENT
  NEGATIVE_ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum PlatformAdministratorStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CommercialPlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum PlanLimitValueType {
  INTEGER
  BOOLEAN
  STRING
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

model SystemMetadata {
  id                    BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  applicationVersion    String   @map("application_version") @db.VarChar(50)
  databaseInitializedAt DateTime @default(now()) @map("database_initialized_at") @db.DateTime(3)
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("system_metadata")
}

model Tenant {
  id                           BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                     String                        @unique @map("public_id") @db.Char(36)
  slug                         String                        @unique @db.VarChar(63)
  legalName                    String                        @map("legal_name") @db.VarChar(160)
  displayName                  String                        @map("display_name") @db.VarChar(120)
  status                       TenantStatus                  @default(ACTIVE)
  timezone                     String                        @db.VarChar(64)
  locale                       String                        @db.VarChar(16)
  currency                     String                        @db.Char(3)
  businessProfile              BusinessProfile               @default(GENERIC) @map("business_profile")
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                    DateTime                      @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  settings                     TenantSettings?
  branding                     TenantBranding?
  terminology                  TenantTerminology?
  featureOverrides             TenantFeatureOverride[]
  customFields                 TenantCustomFieldDefinition[]
  services                     Service[]
  serviceVariations            ServiceVariation[]
  combos                       Combo[]
  comboItems                   ComboItem[]
  customers                    Customer[]
  appointments                 Appointment[]
  serviceCategories            ServiceCategory[]
  professionals                Professional[]
  professionalServices         ProfessionalService[]
  professionalUnits            ProfessionalUnit[]
  professionalWorkSchedules    ProfessionalWorkSchedule[]
  professionalUnavailabilities ProfessionalUnavailability[]
  businessUnitOperatingHours   BusinessUnitOperatingHours[]
  businessUnitDateOverrides    BusinessUnitDateOverride[]
  appointmentHistoryEntries    AppointmentHistoryEntry[]
  customerSessions             CustomerSession[]
  businessUnits                BusinessUnit[]
  memberships                  TenantMembership[]
  roles                        Role[]
  invitations                  UserInvitation[]
  auditLogs                    AuditLog[]
  subscriptions                TenantSubscription[]
  subscriptionHistory          SubscriptionHistory[]
  mediaAssets                  TenantMediaAsset[]
  publicSite                   TenantPublicSite?
  customerFavorites            CustomerFavorite[]
  appointmentReviews           AppointmentReview[]
  notificationLogs             NotificationLog[]
  notificationTemplates        NotificationTemplate[]
  pushSubscriptions            PushSubscription[]
  productCategories            ProductCategory[]
  products                     Product[]
  productStocks                ProductStock[]
  stockMovements               StockMovement[]

  @@index([status])
  @@map("tenants")
}

model User {
  id                            BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                      String                    @unique @map("public_id") @db.Char(36)
  email                         String                    @db.VarChar(254)
  normalizedEmail               String                    @unique @map("normalized_email") @db.VarChar(254)
  passwordHash                  String?                   @map("password_hash") @db.VarChar(255)
  status                        UserStatus                @default(INVITED)
  emailVerifiedAt               DateTime?                 @map("email_verified_at") @db.DateTime(3)
  lastLoginAt                   DateTime?                 @map("last_login_at") @db.DateTime(3)
  passwordChangedAt             DateTime?                 @map("password_changed_at") @db.DateTime(3)
  createdAt                     DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                     DateTime                  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  memberships                   TenantMembership[]
  sessions                      UserSession[]
  passwordResets                PasswordResetToken[]
  invitationsSent               UserInvitation[]          @relation("InvitedByUser")
  auditLogs                     AuditLog[]
  appointmentHistoryEntries     AppointmentHistoryEntry[]
  platformAdministration        PlatformAdministrator[]   @relation("PlatformAdministratorUser")
  platformAdministratorsCreated PlatformAdministrator[]   @relation("PlatformAdministratorCreatedBy")
  subscriptionHistoryPerformed  SubscriptionHistory[]     @relation("SubscriptionHistoryPerformedBy")
  professionalProfiles          Professional[]
  stockMovementsPerformed       StockMovement[]

  @@index([status])
  @@map("users")
}

model Role {
  id          BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  publicId    String             @unique @map("public_id") @db.Char(36)
  tenantId    BigInt?            @map("tenant_id") @db.UnsignedBigInt
  code        String             @unique @db.VarChar(64)
  name        String             @db.VarChar(100)
  description String             @db.VarChar(255)
  isSystem    Boolean            @default(false) @map("is_system")
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant      Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions RolePermission[]
  memberships TenantMembership[]
  invitations UserInvitation[]

  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  code        String           @unique @db.VarChar(100)
  description String           @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt     @map("role_id") @db.UnsignedBigInt
  permissionId BigInt     @map("permission_id") @db.UnsignedBigInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model TenantMembership {
  id        BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  publicId  String           @unique @map("public_id") @db.Char(36)
  tenantId  BigInt           @map("tenant_id") @db.UnsignedBigInt
  userId    BigInt           @map("user_id") @db.UnsignedBigInt
  roleId    BigInt           @map("role_id") @db.UnsignedBigInt
  status    MembershipStatus @default(INVITED)
  isOwner   Boolean          @default(false) @map("is_owner")
  joinedAt  DateTime?        @map("joined_at") @db.DateTime(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, status])
  @@index([roleId])
  @@map("tenant_memberships")
}

model UserSession {
  id                        BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                  String                    @unique @map("public_id") @db.Char(36)
  userId                    BigInt                    @map("user_id") @db.UnsignedBigInt
  tokenHash                 String                    @unique @map("token_hash") @db.Char(64)
  expiresAt                 DateTime                  @map("expires_at") @db.DateTime(3)
  lastSeenAt                DateTime                  @map("last_seen_at") @db.DateTime(3)
  revokedAt                 DateTime?                 @map("revoked_at") @db.DateTime(3)
  revocationReason          String?                   @map("revocation_reason") @db.VarChar(100)
  ipAddress                 String?                   @map("ip_address") @db.VarChar(45)
  userAgent                 String?                   @map("user_agent") @db.VarChar(255)
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  user                      User                      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  auditLogs                 AuditLog[]
  appointmentHistoryEntries AppointmentHistoryEntry[]

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(3)
  usedAt      DateTime? @map("used_at") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  requestedIp String?   @map("requested_ip") @db.VarChar(45)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model UserInvitation {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String           @unique @map("public_id") @db.Char(36)
  tenantId        BigInt           @map("tenant_id") @db.UnsignedBigInt
  email           String           @db.VarChar(254)
  normalizedEmail String           @map("normalized_email") @db.VarChar(254)
  roleId          BigInt           @map("role_id") @db.UnsignedBigInt
  tokenHash       String           @unique @map("token_hash") @db.Char(64)
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at") @db.DateTime(3)
  acceptedAt      DateTime?        @map("accepted_at") @db.DateTime(3)
  invitedByUserId BigInt           @map("invited_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role            Role             @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invitedBy       User             @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, status, expiresAt])
  @@index([normalizedEmail, status])
  @@index([roleId])
  @@index([invitedByUserId])
  @@map("user_invitations")
}

model AuditLog {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String       @unique @map("public_id") @db.Char(36)
  tenantId       BigInt?      @map("tenant_id") @db.UnsignedBigInt
  userId         BigInt?      @map("user_id") @db.UnsignedBigInt
  sessionId      BigInt?      @map("session_id") @db.UnsignedBigInt
  action         String       @db.VarChar(100)
  targetType     String       @map("target_type") @db.VarChar(80)
  targetPublicId String?      @map("target_public_id") @db.Char(36)
  metadata       Json?
  ipAddress      String?      @map("ip_address") @db.VarChar(45)
  userAgent      String?      @map("user_agent") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session        UserSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([sessionId])
  @@map("audit_logs")
}

model NotificationLog {
  id             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String              @unique @map("public_id") @db.Char(36)
  tenantId       BigInt              @map("tenant_id") @db.UnsignedBigInt
  channel        NotificationChannel @default(EMAIL)
  kind           String              @db.VarChar(80)
  targetType     String              @map("target_type") @db.VarChar(80)
  targetPublicId String?             @map("target_public_id") @db.Char(36)
  recipient      String              @db.VarChar(254)
  subject        String              @db.VarChar(255)
  body           String              @db.Text
  status         NotificationStatus  @default(PENDING)
  attempts       Int                 @default(0) @db.UnsignedTinyInt
  lastError      String?             @map("last_error") @db.VarChar(500)
  sentAt         DateTime?           @map("sent_at") @db.DateTime(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, kind, targetType, targetPublicId, channel, recipient], map: "notification_logs_target_key")
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([targetType, targetPublicId])
  @@map("notification_logs")
}

model PushSubscription {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  publicId     String    @unique @map("public_id") @db.Char(36)
  tenantId     BigInt    @map("tenant_id") @db.UnsignedBigInt
  customerId   BigInt    @map("customer_id") @db.UnsignedBigInt
  endpoint     String    @db.Text
  endpointHash String    @unique @map("endpoint_hash") @db.Char(64)
  p256dh       String    @db.VarChar(255)
  auth         String    @db.VarChar(255)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  active       Boolean   @default(true)
  lastUsedAt   DateTime? @map("last_used_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, customerId])
  @@index([tenantId, active])
  @@map("push_subscriptions")
}

model NotificationTemplate {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId  String   @unique @map("public_id") @db.Char(36)
  tenantId  BigInt   @map("tenant_id") @db.UnsignedBigInt
  kind      String   @db.VarChar(80)
  subject   String   @db.VarChar(255)
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, kind])
  @@map("notification_templates")
}

model TenantSettings {
  id                                BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId                          BigInt       @unique @map("tenant_id") @db.UnsignedBigInt
  allowMultipleUnits                Boolean      @default(false) @map("allow_multiple_units")
  defaultAppointmentIntervalMinutes Int          @default(15) @map("default_appointment_interval_minutes") @db.UnsignedSmallInt
  minimumAdvanceMinutes             Int          @default(0) @map("minimum_advance_minutes") @db.UnsignedSmallInt
  maximumAdvanceDays                Int          @default(180) @map("maximum_advance_days") @db.UnsignedSmallInt
  weekStartsOn                      WeekStartsOn @default(MONDAY) @map("week_starts_on")
  dateFormat                        String       @default("DD/MM/YYYY") @map("date_format") @db.VarChar(16)
  timeFormat                        TimeFormat   @default(H24) @map("time_format")
  createdAt                         DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                         DateTime     @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant                            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("tenant_settings")
}

model TenantBranding {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId           BigInt   @unique @map("tenant_id") @db.UnsignedBigInt
  useProfileDefaults Boolean  @default(true) @map("use_profile_defaults")
  primaryColor       String   @map("primary_color") @db.Char(7)
  secondaryColor     String   @map("secondary_color") @db.Char(7)
  accentColor        String   @map("accent_color") @db.Char(7)
  backgroundColor    String   @map("background_color") @db.Char(7)
  surfaceColor       String   @map("surface_color") @db.Char(7)
  textColor          String   @map("text_color") @db.Char(7)
  mutedTextColor     String   @map("muted_text_color") @db.Char(7)
  borderColor        String   @map("border_color") @db.Char(7)
  borderRadius       String   @map("border_radius") @db.VarChar(16)
  fontFamily         String   @map("font_family") @db.VarChar(64)
  logoUrl            String?  @map("logo_url") @db.VarChar(2048)
  faviconUrl         String?  @map("favicon_url") @db.VarChar(2048)
  bannerUrl          String?  @map("banner_url") @db.VarChar(2048)
  pwaIconUrl         String?  @map("pwa_icon_url") @db.VarChar(2048)
  splashUrl          String?  @map("splash_url") @db.VarChar(2048)
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("tenant_branding")
}

model TenantMediaAsset {
  id           BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  publicId     String          @unique @map("public_id") @db.Char(36)
  tenantId     BigInt          @map("tenant_id") @db.UnsignedBigInt
  kind         TenantMediaKind
  originalName String          @map("original_name") @db.VarChar(255)
  storageKey   String          @unique @map("storage_key") @db.VarChar(512)
  mimeType     String          @map("mime_type") @db.VarChar(32)
  byteSize     Int             @map("byte_size") @db.UnsignedInt
  altText      String?         @map("alt_text") @db.VarChar(180)
  deletedAt    DateTime?       @map("deleted_at") @db.DateTime(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, kind, deletedAt])
  @@map("tenant_media_assets")
}

model TenantPublicSite {
  id                  BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId            BigInt            @unique @map("tenant_id") @db.UnsignedBigInt
  theme               TenantPublicTheme @default(CLASSIC)
  heroTitle           String?           @map("hero_title") @db.VarChar(160)
  heroSubtitle        String?           @map("hero_subtitle") @db.VarChar(500)
  aboutText           String?           @map("about_text") @db.VarChar(4000)
  primaryCallToAction String?           @map("primary_call_to_action") @db.VarChar(100)
  footerText          String?           @map("footer_text") @db.VarChar(500)
  seoTitle            String?           @map("seo_title") @db.VarChar(70)
  seoDescription      String?           @map("seo_description") @db.VarChar(160)
  pwaName             String?           @map("pwa_name") @db.VarChar(80)
  pwaShortName        String?           @map("pwa_short_name") @db.VarChar(30)
  pwaDescription      String?           @map("pwa_description") @db.VarChar(160)
  createdAt           DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("tenant_public_sites")
}

model TenantTerminology {
  id                   BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId             BigInt   @unique @map("tenant_id") @db.UnsignedBigInt
  professionalSingular String?  @map("professional_singular") @db.VarChar(80)
  professionalPlural   String?  @map("professional_plural") @db.VarChar(80)
  customerSingular     String?  @map("customer_singular") @db.VarChar(80)
  customerPlural       String?  @map("customer_plural") @db.VarChar(80)
  serviceSingular      String?  @map("service_singular") @db.VarChar(80)
  servicePlural        String?  @map("service_plural") @db.VarChar(80)
  appointmentSingular  String?  @map("appointment_singular") @db.VarChar(80)
  appointmentPlural    String?  @map("appointment_plural") @db.VarChar(80)
  unitSingular         String?  @map("unit_singular") @db.VarChar(80)
  unitPlural           String?  @map("unit_plural") @db.VarChar(80)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("tenant_terminology")
}

model TenantFeatureOverride {
  id        BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId  BigInt              @map("tenant_id") @db.UnsignedBigInt
  code      String              @map("feature_code") @db.VarChar(64)
  enabled   Boolean
  source    TenantFeatureSource @default(OVERRIDE)
  createdAt DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, source])
  @@map("tenant_feature_overrides")
}

model TenantCustomFieldDefinition {
  id          BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  publicId    String                  @unique @map("public_id") @db.Char(36)
  tenantId    BigInt                  @map("tenant_id") @db.UnsignedBigInt
