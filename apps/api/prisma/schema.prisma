model Appointment {
  id                      BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                String                    @unique @map("public_id") @db.Char(36)
  tenantId                BigInt                    @map("tenant_id") @db.UnsignedBigInt
  protocol                String                    @db.VarChar(32)
  customerId              BigInt                    @map("customer_id") @db.UnsignedBigInt
  professionalId          BigInt                    @map("professional_id") @db.UnsignedBigInt
  serviceId               BigInt                    @map("service_id") @db.UnsignedBigInt
  unitId                  BigInt?                   @map("unit_id") @db.UnsignedBigInt
  startsAt                DateTime                  @map("starts_at") @db.DateTime(3)
  endsAt                  DateTime                  @map("ends_at") @db.DateTime(3)
  durationMinutes         Int                       @map("duration_minutes") @db.UnsignedSmallInt
  postServiceBreakMinutes Int                       @default(0) @map("post_service_break_minutes") @db.UnsignedSmallInt
  priceCents              BigInt                    @map("price_cents") @db.UnsignedBigInt
  status                  AppointmentStatus         @default(PENDING)
  notes                   String?                   @db.VarChar(2000)
  source                  String                    @default("INTERNAL") @db.VarChar(64)
  canceledReason          String?                   @map("canceled_reason") @db.VarChar(500)
  rescheduleReason        String?                   @map("reschedule_reason") @db.VarChar(500)
  isFitIn                 Boolean                   @default(false) @map("is_fit_in")
  fitInReason             String?                   @map("fit_in_reason") @db.VarChar(500)
  checkedInAt             DateTime?                 @map("checked_in_at") @db.DateTime(3)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
