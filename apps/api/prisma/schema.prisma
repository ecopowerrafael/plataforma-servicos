model BusinessUnit {
  id                           BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                     String                       @unique @map("public_id") @db.Char(36)
  tenantId                     BigInt                       @map("tenant_id") @db.UnsignedBigInt
  name                         String                       @db.VarChar(120)
  slug                         String                       @db.VarChar(63)
  status                       BusinessUnitStatus           @default(ACTIVE)
  isHeadquarters               Boolean                      @default(false) @map("is_headquarters")
  timezone                     String                       @db.VarChar(64)
  postalCode                   String?                      @map("postal_code") @db.VarChar(16)
  street                       String?                      @db.VarChar(160)
  number                       String?                      @db.VarChar(20)
  complement                   String?                      @db.VarChar(80)
  district                     String?                      @db.VarChar(80)
  city                         String?                      @db.VarChar(100)
  state                        String?                      @db.VarChar(64)
  countryCode                  String?                      @map("country_code") @db.Char(2)
  createdAt                    DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                    DateTime                     @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant                       Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  primaryProfessionals         Professional[]               @relation("ProfessionalPrimaryUnit")
  professionalUnits            ProfessionalUnit[]
  professionalWorkSchedules    ProfessionalWorkSchedule[]
  professionalUnavailabilities ProfessionalUnavailability[]
  operatingHours               BusinessUnitOperatingHours[]
  dateOverrides                BusinessUnitDateOverride[]
  customers                    Customer[]
  appointments                 Appointment[]
  productStocks                ProductStock[]
  stockMovements               StockMovement[]              @relation("StockMovementUnit")
  relatedStockMovements        StockMovement[]              @relation("StockMovementRelatedUnit")

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("business_units")
}

