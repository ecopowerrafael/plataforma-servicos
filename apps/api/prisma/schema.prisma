model Product {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String           @unique @map("public_id") @db.Char(36)
  tenantId       BigInt           @map("tenant_id") @db.UnsignedBigInt
  categoryId     BigInt?          @map("category_id") @db.UnsignedBigInt
  name           String           @db.VarChar(160)
  description    String?          @db.VarChar(1000)
  sku            String?          @db.VarChar(80)
  barcode        String?          @db.VarChar(80)
  costPriceCents BigInt           @default(0) @map("cost_price_cents") @db.UnsignedBigInt
  salePriceCents BigInt           @map("sale_price_cents") @db.UnsignedBigInt
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  stocks         ProductStock[]
  movements      StockMovement[]

  @@unique([tenantId, name])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, active, name])
  @@index([tenantId, categoryId])
  @@map("products")
}

model ProductStock {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String       @unique @map("public_id") @db.Char(36)
  tenantId        BigInt       @map("tenant_id") @db.UnsignedBigInt
