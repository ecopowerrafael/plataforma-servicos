enum BusinessUnitStatus {
  ACTIVE
  INACTIVE
}

enum WeekStartsOn {
  SUNDAY
  MONDAY
}

enum TimeFormat {
  H24 @map("24H")
  H12 @map("12H")
}

enum UserStatus {
  ACTIVE
