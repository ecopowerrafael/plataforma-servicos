  review                  AppointmentReview?

  @@unique([tenantId, protocol])
  @@index([tenantId, professionalId, startsAt, endsAt, status])
  @@index([tenantId, customerId, startsAt])
  @@map("appointments")
}

model CustomerFavorite {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String        @unique @map("public_id") @db.Char(36)
  tenantId       BigInt        @map("tenant_id") @db.UnsignedBigInt
  customerId     BigInt        @map("customer_id") @db.UnsignedBigInt
  professionalId BigInt?       @map("professional_id") @db.UnsignedBigInt
  serviceId      BigInt?       @map("service_id") @db.UnsignedBigInt
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([customerId, professionalId])
  @@unique([customerId, serviceId])
  @@index([tenantId, customerId])
  @@map("customer_favorites")
}

model AppointmentReview {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String       @unique @map("public_id") @db.Char(36)
  tenantId       BigInt       @map("tenant_id") @db.UnsignedBigInt
  appointmentId  BigInt       @unique @map("appointment_id") @db.UnsignedBigInt
  customerId     BigInt       @map("customer_id") @db.UnsignedBigInt
  professionalId BigInt       @map("professional_id") @db.UnsignedBigInt
  serviceId      BigInt       @map("service_id") @db.UnsignedBigInt
  rating         Int          @db.UnsignedTinyInt
  comment        String?      @db.VarChar(1000)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, customerId])
  @@index([tenantId, professionalId])
  @@map("appointment_reviews")
}

enum AppointmentHistoryAction {
  CREATED
  STATUS_CHANGED
  RESCHEDULED
  CHECKED_IN
}

model AppointmentHistoryEntry {
  id               BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String                   @unique @map("public_id") @db.Char(36)
  tenantId         BigInt                   @map("tenant_id") @db.UnsignedBigInt
  appointmentId    BigInt                   @map("appointment_id") @db.UnsignedBigInt
  action           AppointmentHistoryAction
  previousStatus   AppointmentStatus?       @map("previous_status")
  newStatus        AppointmentStatus?       @map("new_status")
  previousStartsAt DateTime?                @map("previous_starts_at") @db.DateTime(3)
  newStartsAt      DateTime?                @map("new_starts_at") @db.DateTime(3)
  reason           String?                  @db.VarChar(500)
  isFitIn          Boolean                  @default(false) @map("is_fit_in")
  userId           BigInt?                  @map("user_id") @db.UnsignedBigInt
  sessionId        BigInt?                  @map("session_id") @db.UnsignedBigInt
  createdAt        DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointment      Appointment              @relation(fields: [appointmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user             User?                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session          UserSession?             @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, appointmentId, createdAt])
  @@map("appointment_history_entries")
}

model ProfessionalWorkSchedule {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String        @unique @map("public_id") @db.Char(36)
  tenantId       BigInt        @map("tenant_id") @db.UnsignedBigInt
  professionalId BigInt        @map("professional_id") @db.UnsignedBigInt
  unitId         BigInt?       @map("unit_id") @db.UnsignedBigInt
  weekday        Int           @db.UnsignedTinyInt
  startsAt       String        @map("starts_at") @db.Char(5)
  endsAt         String        @map("ends_at") @db.Char(5)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  unit           BusinessUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId, professionalId, weekday, active])
  @@map("professional_work_schedules")
}

model ProfessionalUnavailability {
  id               BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String                         @unique @map("public_id") @db.Char(36)
  tenantId         BigInt                         @map("tenant_id") @db.UnsignedBigInt
  professionalId   BigInt                         @map("professional_id") @db.UnsignedBigInt
  unitId           BigInt?                        @map("unit_id") @db.UnsignedBigInt
  type             ProfessionalUnavailabilityType
  title            String                         @db.VarChar(160)
  reason           String?                        @db.VarChar(1000)
  startsAt         DateTime                       @map("starts_at") @db.DateTime(3)
  endsAt           DateTime                       @map("ends_at") @db.DateTime(3)
  allDay           Boolean                        @default(false) @map("all_day")
  repeatsWeekly    Boolean                        @default(false) @map("repeats_weekly")
  recurrenceEndsAt DateTime?                      @map("recurrence_ends_at") @db.DateTime(3)
  active           Boolean                        @default(true)
  createdAt        DateTime                       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                       @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant           Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  professional     Professional                   @relation(fields: [professionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  unit             BusinessUnit?                  @relation(fields: [unitId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId, professionalId, startsAt, endsAt, active])
  @@index([tenantId, type, active])
  @@map("professional_unavailabilities")
}

model ProfessionalService {
  id                      BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  publicId                String          @unique @map("public_id") @db.Char(36)
  tenantId                BigInt          @map("tenant_id") @db.UnsignedBigInt
  professionalId          BigInt          @map("professional_id") @db.UnsignedBigInt
  serviceId               BigInt          @map("service_id") @db.UnsignedBigInt
  priceCents              BigInt?         @map("price_cents") @db.UnsignedBigInt
  durationMinutes         Int?            @map("duration_minutes") @db.UnsignedSmallInt
  hasPostServiceBreak     Boolean?        @map("has_post_service_break")
  postServiceBreakMinutes Int?            @map("post_service_break_minutes") @db.UnsignedSmallInt
  commissionType          CommissionType? @map("commission_type")
  commissionValue         Int?            @map("commission_value") @db.UnsignedInt
  active                  Boolean         @default(true)
  createdAt               DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant                  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  professional            Professional    @relation(fields: [professionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service                 Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([professionalId, serviceId])
  @@index([tenantId, professionalId, active])
  @@index([tenantId, serviceId, active])
  @@map("professional_services")
}

model ProfessionalUnit {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String       @unique @map("public_id") @db.Char(36)
  tenantId       BigInt       @map("tenant_id") @db.UnsignedBigInt
  professionalId BigInt       @map("professional_id") @db.UnsignedBigInt
  unitId         BigInt       @map("unit_id") @db.UnsignedBigInt
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  unit           BusinessUnit @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([professionalId, unitId])
  @@index([tenantId, professionalId, active])
  @@index([tenantId, unitId, active])
  @@map("professional_units")
}

model PlatformAdministrator {
  id              BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String                      @unique @map("public_id") @db.Char(36)
  userId          BigInt                      @unique @map("user_id") @db.UnsignedBigInt
  status          PlatformAdministratorStatus @default(ACTIVE)
  createdByUserId BigInt?                     @map("created_by_user_id") @db.UnsignedBigInt
  lastAccessAt    DateTime?                   @map("last_access_at") @db.DateTime(3)
  createdAt       DateTime                    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime                    @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  user            User                        @relation("PlatformAdministratorUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User?                       @relation("PlatformAdministratorCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roles           PlatformAdministratorRole[]

  @@index([status])
  @@index([createdByUserId])
  @@map("platform_administrators")
}

model PlatformRole {
  id             BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  code           String                      @unique @db.VarChar(64)
  name           String                      @db.VarChar(100)
  description    String                      @db.VarChar(255)
  isSystem       Boolean                     @default(true) @map("is_system")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                    @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  permissions    PlatformRolePermission[]
  administrators PlatformAdministratorRole[]

  @@map("platform_roles")
}

model PlatformPermission {
  id          BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  code        String                   @unique @db.VarChar(100)
  description String                   @db.VarChar(255)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  roles       PlatformRolePermission[]

  @@map("platform_permissions")
}

model PlatformRolePermission {
  roleId       BigInt             @map("role_id") @db.UnsignedBigInt
  permissionId BigInt             @map("permission_id") @db.UnsignedBigInt
  createdAt    DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  role         PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission   PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("platform_role_permissions")
}

model PlatformAdministratorRole {
  administratorId BigInt                @map("administrator_id") @db.UnsignedBigInt
  roleId          BigInt                @map("role_id") @db.UnsignedBigInt
  createdAt       DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  administrator   PlatformAdministrator @relation(fields: [administratorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role            PlatformRole          @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([administratorId, roleId])
  @@index([roleId])
  @@map("platform_administrator_roles")
}

model CommercialPlan {
  id            BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  publicId      String               @unique @map("public_id") @db.Char(36)
  code          String               @unique @db.VarChar(64)
  name          String               @db.VarChar(120)
  description   String?              @db.VarChar(500)
  status        CommercialPlanStatus @default(ACTIVE)
  billingCycle  BillingCycle         @map("billing_cycle")
  priceCents    BigInt               @map("price_cents") @db.UnsignedBigInt
  currency      String               @db.Char(3)
  trialDays     Int                  @default(0) @map("trial_days") @db.UnsignedSmallInt
  isPublic      Boolean              @default(false) @map("is_public")
  sortOrder     Int                  @default(0) @map("sort_order")
  createdAt     DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  limits        PlanLimit[]
  subscriptions TenantSubscription[]

  @@index([status, sortOrder])
  @@index([billingCycle])
  @@map("commercial_plans")
}

model PlanLimit {
  id           BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  planId       BigInt             @map("plan_id") @db.UnsignedBigInt
  key          String             @db.VarChar(100)
  valueType    PlanLimitValueType @map("value_type")
  integerValue BigInt?            @map("integer_value") @db.UnsignedBigInt
  booleanValue Boolean?           @map("boolean_value")
  stringValue  String?            @map("string_value") @db.VarChar(255)
  createdAt    DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  plan         CommercialPlan     @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([planId, key])
  @@map("plan_limits")
}

model TenantSubscription {
  id                    BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  publicId              String                @unique @map("public_id") @db.Char(36)
  tenantId              BigInt                @map("tenant_id") @db.UnsignedBigInt
  planId                BigInt                @map("plan_id") @db.UnsignedBigInt
  status                SubscriptionStatus
  startsAt              DateTime              @map("starts_at") @db.DateTime(3)
  trialEndsAt           DateTime?             @map("trial_ends_at") @db.DateTime(3)
  currentPeriodStartsAt DateTime              @map("current_period_starts_at") @db.DateTime(3)
  currentPeriodEndsAt   DateTime              @map("current_period_ends_at") @db.DateTime(3)
  canceledAt            DateTime?             @map("canceled_at") @db.DateTime(3)
  suspendedAt           DateTime?             @map("suspended_at") @db.DateTime(3)
  endsAt                DateTime?             @map("ends_at") @db.DateTime(3)
  priceCents            BigInt                @map("price_cents") @db.UnsignedBigInt
  currency              String                @db.Char(3)
  billingCycle          BillingCycle          @map("billing_cycle")
  effectiveKey          String?               @map("effective_key") @db.VarChar(20)
  createdAt             DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  plan                  CommercialPlan        @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  history               SubscriptionHistory[]

  @@unique([tenantId, effectiveKey])
  @@index([status, currentPeriodEndsAt])
  @@index([planId, status])
  @@map("tenant_subscriptions")
}

model SubscriptionHistory {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  publicId          String              @unique @map("public_id") @db.Char(36)
  subscriptionId    BigInt              @map("subscription_id") @db.UnsignedBigInt
  tenantId          BigInt              @map("tenant_id") @db.UnsignedBigInt
  action            String              @db.VarChar(50)
  previousStatus    SubscriptionStatus? @map("previous_status")
  newStatus         SubscriptionStatus? @map("new_status")
  previousPlanId    BigInt?             @map("previous_plan_id") @db.UnsignedBigInt
  newPlanId         BigInt?             @map("new_plan_id") @db.UnsignedBigInt
  reason            String?             @db.VarChar(500)
  metadata          Json?
  performedByUserId BigInt?             @map("performed_by_user_id") @db.UnsignedBigInt
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  subscription      TenantSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  performedByUser   User?               @relation("SubscriptionHistoryPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([action, createdAt])
  @@map("subscription_history")
}
