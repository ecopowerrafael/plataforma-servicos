enum NotificationCampaignStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

/// A campanha apenas agrupa logs já existentes: o worker e as tentativas
/// continuam pertencendo a NotificationLog, sem uma segunda fila.
model NotificationCampaign {
  id         BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  publicId   String              @unique @map("public_id") @db.Char(36)
  tenantId   BigInt              @map("tenant_id") @db.UnsignedBigInt
