enum PaymentMethodType {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PAID
  CANCELED
}

enum PaymentKind {
  PAYMENT
  DEPOSIT
}

enum DepositType {
  FIXED
  PERCENTAGE
}

enum CouponDiscountType {
  FIXED
  PERCENTAGE
}

enum LoyaltyType {
  POINTS
  CASHBACK
}

enum LoyaltyDirection {
