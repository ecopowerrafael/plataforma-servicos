model Professional {
  id                   BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId             String                       @unique @map("public_id") @db.Char(36)
  tenantId             BigInt                       @map("tenant_id") @db.UnsignedBigInt
  primaryUnitId        BigInt?                      @map("primary_unit_id") @db.UnsignedBigInt
  userId               BigInt?                      @map("user_id") @db.UnsignedBigInt
  name                 String                       @db.VarChar(120)
  publicName           String                       @map("public_name") @db.VarChar(120)
  bio                  String?                      @db.VarChar(2000)
  photoPath            String?                      @map("photo_path") @db.VarChar(512)
  phone                String?                      @db.VarChar(32)
  email                String?                      @db.VarChar(254)
  professionalDocument String?                      @map("professional_document") @db.VarChar(80)
  specialties          Json?
  calendarColor        String                       @map("calendar_color") @db.Char(7)
  sortOrder            Int                          @default(0) @map("sort_order") @db.UnsignedSmallInt
  active               Boolean                      @default(true)
  commissionType       CommissionType               @default(PERCENTAGE) @map("commission_type")
  commissionValue      Int                          @default(0) @map("commission_value") @db.UnsignedInt
  customFields         Json?                        @map("custom_fields")
  createdAt            DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime                     @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  primaryUnit          BusinessUnit?                @relation("ProfessionalPrimaryUnit", fields: [primaryUnitId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user                 User?                        @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  services             ProfessionalService[]
  units                ProfessionalUnit[]
  workSchedules        ProfessionalWorkSchedule[]
  unavailabilities     ProfessionalUnavailability[]
  appointments         Appointment[]
  favoritedBy          CustomerFavorite[]
  reviews              AppointmentReview[]

  @@unique([tenantId, userId])
  @@index([tenantId, active, sortOrder])
  @@index([tenantId, primaryUnitId])
  @@map("professionals")
}

model Customer {
  id                    BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  publicId              String              @unique @map("public_id") @db.Char(36)
  tenantId              BigInt              @map("tenant_id") @db.UnsignedBigInt
  primaryUnitId         BigInt?             @map("primary_unit_id") @db.UnsignedBigInt
  name                  String              @db.VarChar(120)
  socialName            String?             @map("social_name") @db.VarChar(120)
  phone                 String?             @db.VarChar(32)
  whatsapp              String?             @db.VarChar(32)
  email                 String?             @db.VarChar(254)
  birthDate             DateTime?           @map("birth_date") @db.Date
  document              String?             @db.VarChar(80)
  notes                 String?             @db.VarChar(2000)
  status                CustomerStatus      @default(ACTIVE)
  source                String              @default("MANUAL") @db.VarChar(64)
  acceptsCommunications Boolean             @default(false) @map("accepts_communications")
  passwordHash          String?             @map("password_hash") @db.VarChar(255)
  customFields          Json?               @map("custom_fields")
  createdAt             DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
