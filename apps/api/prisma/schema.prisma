}

model StockMovement {
  id                    BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  publicId              String            @unique @map("public_id") @db.Char(36)
  transferPublicId      String?           @map("transfer_public_id") @db.Char(36)
  tenantId              BigInt            @map("tenant_id") @db.UnsignedBigInt
  productId             BigInt            @map("product_id") @db.UnsignedBigInt
  businessUnitId        BigInt            @map("business_unit_id") @db.UnsignedBigInt
  relatedBusinessUnitId BigInt?           @map("related_business_unit_id") @db.UnsignedBigInt
  type                  StockMovementType
  quantity              Int               @db.UnsignedInt
  previousQuantity      Int               @map("previous_quantity") @db.UnsignedInt
  resultingQuantity     Int               @map("resulting_quantity") @db.UnsignedInt
  reason                String?           @db.VarChar(500)
  performedByUserId     BigInt            @map("performed_by_user_id") @db.UnsignedBigInt
  createdAt             DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product               Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  businessUnit          BusinessUnit      @relation("StockMovementUnit", fields: [businessUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relatedBusinessUnit   BusinessUnit?     @relation("StockMovementRelatedUnit", fields: [relatedBusinessUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  performedByUser       User              @relation(fields: [performedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, productId, businessUnitId, createdAt])
  @@index([transferPublicId])
  @@index([performedByUserId, createdAt])
  @@map("stock_movements")
}

model Service {
