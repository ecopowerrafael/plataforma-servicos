NODE_ENV=production
PUBLIC_HOSTNAME=app.example.com
MYSQL_DATABASE=agendei
MYSQL_USER=agendei_app
MYSQL_PASSWORD=replace-with-a-random-secret
MYSQL_ROOT_PASSWORD=replace-with-a-separate-random-secret
API_HOST=0.0.0.0
API_PORT=3000
APP_WEB_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
AUTH_COOKIE_SECURE=true
LOG_LEVEL=info
WAPI_WEBHOOK_SECRET=replace-with-at-least-32-characters
PROSPECTING_WORKER_ENABLED=false
PROSPECTING_DRY_RUN=true
